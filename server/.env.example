# biz-performance-voice-agent - Environment Variables
# Copy this file to .env and fill in your API keys

# Which dataset under server/data/ the calculation engine reads from.
# Populate it first: python scripts/sync_data.py --source <path> --name <this-value>
DATA_DIR=data/baseline_seed42

# LLM provider selection (dev_llm_client.py for Phase 1, llm_factory.py for
# Phase 2's bot.py): deepseek | anthropic | openai
LLM_PROVIDER=deepseek
LLM_MODEL=

# DeepSeek (LLM)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Optional: route DeepSeek calls through a CostGuard gateway instead of
# api.deepseek.com directly. Leave both unset for plain direct DeepSeek
# usage. If set, DEEPSEEK_API_KEY above should hold a cgmk_... monitoring
# key, not a real DeepSeek key. Same convention as kyc-voice-agent.
DEEPSEEK_BASE_URL=
DEEPSEEK_GATEWAY_PROVIDER_ID=

# Anthropic (LLM). ANTHROPIC_BASE_URL is optional CostGuard gateway routing.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# OpenAI (LLM)
OPENAI_API_KEY=

# --- Judge LLM (judge.py) -----------------------------------------------
# An independent, typically higher-capability model that audits each ask's
# full evidence trail after the fact and returns a strict pass/fail with
# the earliest pipeline stage that went wrong. Deliberately separate from
# the actor above -- leave both blank to just reuse LLM_PROVIDER/LLM_MODEL
# (not recommended: the judge should usually be a stronger model than the
# one it's grading). deepseek | anthropic | openai.
JUDGE_LLM_PROVIDER=deepseek
# Defaults: deepseek -> deepseek-reasoner, anthropic -> claude-opus-5, openai -> gpt-4o
JUDGE_LLM_MODEL=
# Only set these if the judge should use a DIFFERENT key/account than the
# actor (e.g. separate billing/monitoring) -- otherwise it reuses
# DEEPSEEK_API_KEY / ANTHROPIC_API_KEY above.
JUDGE_DEEPSEEK_API_KEY=
JUDGE_ANTHROPIC_API_KEY=

# When the judge runs automatically (always as a background task -- never
# blocks the /ask response either way): off | flagged | all
#   off     - never auto-runs; trigger manually via POST /admin/query-log/{id}/judge
#   flagged - (default) only for asks the cheap automatic check didn't mark "answered"
#   all     - every single ask (highest coverage, highest cost)
JUDGE_AUTO_RUN=flagged

# --- Phase 2 (voice) only -- not needed to run Phase 1's /ask endpoint ---
# Sarvam (STT/TTS)
SARVAM_API_KEY=
SARVAM_MODEL=
SARVAM_VOICE_ID=priya
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_PACE=0.85

# Cloudflare TURN (turn_credentials.py). Without these, SmallWebRTC has zero
# ICE servers configured -- fine on localhost (client and server share host
# candidates), but a deployed backend needs a TURN relay to ever connect to
# a browser on a different network. Get both from the Cloudflare dashboard's
# Turn Server product (dash.cloudflare.com -> Turn Server -> create a TURN
# app); the API token is shown only once at creation time.
CF_TURN_TOKEN_ID=
CF_TURN_API_TOKEN=

# Admin dashboard shared secret (admin.py). Required to view /admin/* --
# the endpoints fail closed (deny everyone) if this is left unset.
ADMIN_KEY=
